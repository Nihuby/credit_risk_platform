# ─────────────────────────────────────────────────────────────────────────────
# AI-Powered Credit Risk Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required for Talk-to-Data NL→SQL) ─────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: override for compatible LLM endpoints (Groq, Azure, Ollama proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Kaggle credentials (required for automated dataset download) ──────────────
# Option A (recommended): place kaggle.json at C:\Users\<USER>\.kaggle\kaggle.json
# Option B: set the variables below
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ── Database paths (optional overrides) ──────────────────────────────────────
# DUCKDB_PATH=data/credit_risk.duckdb

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
